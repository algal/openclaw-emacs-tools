{
  "name": "emacs-tools",
  "version": "0.1.0",
  "private": true,
  "description": "OpenClaw plugin: Emacs tools via emacsclient",
  "type": "module",
  "bin": {
    "claw-emacs": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/core.js",
    "dist/plugin.js",
    "README.md",
    "openclaw.plugin.json"
  ],
  "openclaw": {
    "extensions": [
      "./dist/plugin.js"
    ]
  },
  "dependencies": {
    "openclaw": "file:../openclaw",
    "typebox": "^1.1.39"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "chmod 755 dist/cli.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "plugin:validate": "npm run build && openclaw plugins validate --entry ./dist/plugin.js",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
